# Copia in /etc/yourradio/backup.env sul server Register (yourradio.org)
# chmod 600 /etc/yourradio/backup.env

# --- Origine (server Register / Fabric) ---
SOURCE_HOST=yourradio.org
SOURCE_PLAYER=/var/www/vhosts/yourradio.org/httpdocs/player
SOURCE_HTTPDOCS=/var/www/vhosts/yourradio.org/httpdocs
# Cartelle extra (separate da spazio)
SOURCE_EXTRA_PATHS=""

# Dump MySQL locale (creato sul server Register prima del rsync)
# Consigliato: utente read-only + file /root/.my.cnf-backup (chmod 600)
#   [client]
#   user=backup_readonly
#   password=...
#   host=localhost
MYSQL_HOST=localhost
MYSQL_USER=backup_readonly
MYSQL_PASSWORD=CHANGE_ME
# Obbligatorio per il dump (se vuoto lo script salta MySQL)
MYSQL_DATABASE=myradio
MYSQL_CNF=/root/.my.cnf-backup

# --- Destinazione (server Aruba) ---
# Mirror fisso (NON cartelle per data):
#   ARUBA_BASE/player/
#   ARUBA_BASE/httpdocs/
#   ARUBA_BASE/mysql/
ARUBA_HOST=s2.yourradio.org
ARUBA_USER=CHANGE_ME_PLESK_USER
ARUBA_SSH_PORT=22
ARUBA_SSH_KEY=/root/.ssh/id_ed25519_aruba_backup
ARUBA_BASE=/var/www/vhosts/s2.yourradio.org/backups/yourradio.org
# OpenSSH vecchio (Register): non usare accept-new. Default yes (host già in known_hosts).
SSH_STRICT_HOST_KEY=yes

# Retention dump SQL (giorni) — vale per i .sql.gz, non per player/httpdocs
RETENTION_DAYS=14

# rsync: limita banda di notte (KB/s). Default script=5000 (~5MB/s). 0=illimitato (NON usare di giorno)
RSYNC_BWLIMIT=5000

# Priorità bassa (nice 19, ionice idle=3)
BACKUP_NICE=19
BACKUP_IONICE_CLASS=3

# Notifiche (opzionale)
MAIL_TO=""
MAIL_FROM="backup@yourradio.org"
