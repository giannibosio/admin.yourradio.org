#!/usr/bin/env bash
# Backup YourRadio: server Register -> server Aruba (rsync mirror + mysqldump)
#
# Modalità MIRROR: sempre le stesse cartelle su Aruba (solo differenze):
#   $ARUBA_BASE/player/
#   $ARUBA_BASE/httpdocs/
#   $ARUBA_BASE/mysql/     (dump datati + symlink myradio.sql.gz)
#
# Cron:
#   0 2 * * * /usr/local/bin/yourradio-backup >> /var/log/yourradio-backup/cron.log 2>&1
#
set -euo pipefail

CONFIG="${YOURRADIO_BACKUP_CONFIG:-/etc/yourradio/backup.env}"
LOCK_FILE="/var/run/yourradio-backup.lock"
LOG_DIR="/var/log/yourradio-backup"
STAMP="$(date +%Y%m%d_%H%M%S)"
DATE_TAG="$(date +%Y-%m-%d)"
TODAY_START="$(date +%s)"

log() {
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*"
}

die() {
  log "ERRORE: $*"
  notify_failure "$*"
  exit 1
}

notify_failure() {
  local msg="$1"
  if [[ -n "${MAIL_TO:-}" ]] && command -v mail >/dev/null 2>&1; then
    echo "$msg" | mail -s "YourRadio backup FALLITO ($DATE_TAG)" ${MAIL_FROM:+-r "$MAIL_FROM"} "$MAIL_TO" || true
  fi
}

notify_success() {
  local msg="$1"
  if [[ -n "${MAIL_TO:-}" ]] && command -v mail >/dev/null 2>&1; then
    echo "$msg" | mail -s "YourRadio backup OK ($DATE_TAG)" ${MAIL_FROM:+-r "$MAIL_FROM"} "$MAIL_TO" || true
  fi
}

cleanup() {
  local code=$?
  rm -f "$LOCK_FILE"
  if [[ $code -ne 0 ]]; then
    log "Script terminato con codice $code"
  fi
}
trap cleanup EXIT

if [[ ! -f "$CONFIG" ]]; then
  echo "File config mancante: $CONFIG" >&2
  exit 1
fi
# shellcheck disable=SC1090
source "$CONFIG"

mkdir -p "$LOG_DIR"
LOG_FILE="$LOG_DIR/backup_${STAMP}.log"
exec > >(tee -a "$LOG_FILE") 2>&1

log "=== Avvio backup YourRadio -> Aruba (mirror) ==="
log "Config: $CONFIG"
log "Log: $LOG_FILE"

if [[ -f "$LOCK_FILE" ]]; then
  old_pid="$(cat "$LOCK_FILE" 2>/dev/null || echo "")"
  if [[ -n "$old_pid" ]] && kill -0 "$old_pid" 2>/dev/null; then
    die "Backup già in esecuzione (PID $old_pid)"
  fi
  log "Lock obsoleto rimosso"
  rm -f "$LOCK_FILE"
fi
echo $$ > "$LOCK_FILE"

for cmd in rsync ssh mysqldump; do
  command -v "$cmd" >/dev/null || die "Comando mancante: $cmd"
done

: "${ARUBA_HOST:?ARUBA_HOST non impostato}"
: "${ARUBA_USER:?ARUBA_USER non impostato}"
: "${ARUBA_BASE:?ARUBA_BASE non impostato}"

# OpenSSH vecchio (Register): niente accept-new
SSH_STRICT="${SSH_STRICT_HOST_KEY:-yes}"
SSH_OPTS=(-o BatchMode=yes -o "StrictHostKeyChecking=${SSH_STRICT}" -p "${ARUBA_SSH_PORT:-22}")
if [[ -n "${ARUBA_SSH_KEY:-}" && -f "$ARUBA_SSH_KEY" ]]; then
  SSH_OPTS+=(-i "$ARUBA_SSH_KEY" -o IdentitiesOnly=yes)
fi

RSYNC_SSH="ssh ${SSH_OPTS[*]}"
RSYNC_BWLIMIT="${RSYNC_BWLIMIT:-5000}"
RSYNC_OPTS=(-aH --delete --numeric-ids --partial --human-readable)
if [[ "${RSYNC_BWLIMIT}" != "0" ]]; then
  RSYNC_OPTS+=(--bwlimit="$RSYNC_BWLIMIT")
  log "rsync bwlimit: ${RSYNC_BWLIMIT} KB/s"
fi

NICE_BIN=()
if command -v nice >/dev/null 2>&1; then
  NICE_BIN+=(nice -n "${BACKUP_NICE:-19}")
fi
if command -v ionice >/dev/null 2>&1; then
  NICE_BIN+=(ionice -c "${BACKUP_IONICE_CLASS:-3}")
fi
run_slow() {
  if [[ ${#NICE_BIN[@]} -gt 0 ]]; then
    "${NICE_BIN[@]}" "$@"
  else
    "$@"
  fi
}

# exit 24 = file vanished durante sync (xml player) → OK
rsync_run() {
  local rc=0
  set +e
  run_slow rsync "${RSYNC_OPTS[@]}" -e "$RSYNC_SSH" "$@"
  rc=$?
  set -e
  if [[ $rc -eq 0 || $rc -eq 24 ]]; then
    if [[ $rc -eq 24 ]]; then
      log "WARN: rsync code 24 (file vanished) — considerato OK"
    fi
    return 0
  fi
  return "$rc"
}

REMOTE="${ARUBA_USER}@${ARUBA_HOST}"
# Destinazione FISSA (mirror, non cartelle per data)
DEST_PLAYER="${ARUBA_BASE}/player"
DEST_HTTPDOCS="${ARUBA_BASE}/httpdocs"
DEST_MYSQL="${ARUBA_BASE}/mysql"
DEST_EXTRA="${ARUBA_BASE}/extra"

log "Destinazione mirror: ${REMOTE}:${ARUBA_BASE}/{player,httpdocs,mysql}"
log "Verifica connessione SSH verso $REMOTE ..."
ssh "${SSH_OPTS[@]}" "$REMOTE" "mkdir -p '$DEST_PLAYER' '$DEST_HTTPDOCS' '$DEST_MYSQL' '$DEST_EXTRA'" \
  || die "Impossibile connettersi o creare cartelle su Aruba"

# --- MySQL dump ---
DUMP_OK=0
if [[ -n "${MYSQL_DATABASE:-}" ]]; then
  LOCAL_DUMP_DIR="/var/backups/yourradio/mysql"
  mkdir -p "$LOCAL_DUMP_DIR"
  DUMP_FILE="$LOCAL_DUMP_DIR/myradio_${STAMP}.sql.gz"
  log "Dump MySQL: $MYSQL_DATABASE -> $DUMP_FILE"
  if [[ -n "${MYSQL_CNF:-}" && -f "$MYSQL_CNF" ]]; then
    run_slow mysqldump \
      --defaults-extra-file="$MYSQL_CNF" \
      --single-transaction \
      --routines \
      --triggers \
      --events \
      "$MYSQL_DATABASE" \
      | run_slow gzip -1 > "$DUMP_FILE" \
      || die "mysqldump fallito"
  else
    run_slow mysqldump \
      --host="${MYSQL_HOST:-localhost}" \
      --user="$MYSQL_USER" \
      --password="$MYSQL_PASSWORD" \
      --single-transaction \
      --routines \
      --triggers \
      --events \
      "$MYSQL_DATABASE" \
      | run_slow gzip -1 > "$DUMP_FILE" \
      || die "mysqldump fallito"
  fi
  DUMP_OK=1

  log "Invio dump su Aruba ..."
  rsync_run \
    "$DUMP_FILE" \
    "${REMOTE}:${DEST_MYSQL}/" \
    || die "rsync dump fallito"

  ssh "${SSH_OPTS[@]}" "$REMOTE" \
    "ln -sfn '$(basename "$DUMP_FILE")' '$DEST_MYSQL/myradio.sql.gz'" \
    || log "WARN: symlink myradio.sql.gz non creato"
else
  log "MYSQL_DATABASE non impostato: salto dump DB"
fi

# --- Player (mirror) ---
PLAYER_RSYNCED=0
if [[ -n "${SOURCE_PLAYER:-}" && -d "$SOURCE_PLAYER" ]]; then
  log "rsync PLAYER (mirror): $SOURCE_PLAYER -> ${REMOTE}:${DEST_PLAYER}/"
  rsync_run \
    "${SOURCE_PLAYER}/" \
    "${REMOTE}:${DEST_PLAYER}/" \
    || die "rsync player fallito"
  PLAYER_RSYNCED=1
else
  die "SOURCE_PLAYER mancante o non esiste: ${SOURCE_PLAYER:-<vuoto>}"
fi

# --- httpdocs (mirror, escluso player) ---
HTTPDOCS_RSYNCED=0
if [[ -n "${SOURCE_HTTPDOCS:-}" && -d "$SOURCE_HTTPDOCS" ]]; then
  log "rsync HTTPDOCS (mirror): $SOURCE_HTTPDOCS -> ${REMOTE}:${DEST_HTTPDOCS}/"
  rsync_run \
    --exclude 'player/' \
    --exclude 'cache/' \
    --exclude 'tmp/' \
    --exclude '.git/' \
    "${SOURCE_HTTPDOCS}/" \
    "${REMOTE}:${DEST_HTTPDOCS}/" \
    || die "rsync httpdocs fallito"
  HTTPDOCS_RSYNCED=1
fi

# --- Path extra ---
EXTRA_COUNT=0
if [[ -n "${SOURCE_EXTRA_PATHS:-}" ]]; then
  for extra in $SOURCE_EXTRA_PATHS; do
    if [[ -d "$extra" ]]; then
      name="$(basename "$extra")"
      log "rsync extra (mirror): $extra"
      rsync_run \
        "${extra}/" \
        "${REMOTE}:${DEST_EXTRA}/${name}/" \
        || log "WARN: rsync extra fallito per $extra"
      EXTRA_COUNT=$((EXTRA_COUNT + 1))
    else
      log "WARN: path extra ignorato (non esiste): $extra"
    fi
  done
fi

# Retention dump SQL (locale Register + remoto Aruba)
if [[ -d "/var/backups/yourradio/mysql" && "${RETENTION_DAYS:-0}" -gt 0 ]]; then
  find /var/backups/yourradio/mysql -name 'myradio_*.sql.gz' -mtime +"$RETENTION_DAYS" -delete || true
fi
if [[ "${RETENTION_DAYS:-0}" -gt 0 ]]; then
  ssh "${SSH_OPTS[@]}" "$REMOTE" \
    "find '$DEST_MYSQL' -maxdepth 1 -type f -name 'myradio_*.sql.gz' -mtime +${RETENTION_DAYS} -delete" \
    || log "WARN: retention dump Aruba non completata"
fi

ELAPSED=$(( $(date +%s) - TODAY_START ))
SUMMARY="Backup MIRROR completato in ${ELAPSED}s
Player: $([[ $PLAYER_RSYNCED -eq 1 ]] && echo OK || echo SKIP)
Httpdocs: $([[ $HTTPDOCS_RSYNCED -eq 1 ]] && echo OK || echo SKIP)
MySQL dump: $([[ $DUMP_OK -eq 1 ]] && echo OK || echo SKIP)
Path extra: $EXTRA_COUNT
Destinazione: ${REMOTE}:${ARUBA_BASE}
Log: $LOG_FILE"

log "=== RIEPILOGO ==="
echo "$SUMMARY" | while IFS= read -r line; do log "$line"; done

notify_success "$SUMMARY"
log "=== Fine backup ==="
exit 0
